# Legacy host being redirected.
DOMAIN=ifc43-docs.standards.buildingsmart.org

# Email used for Let's Encrypt expiry notices.
CERTBOT_EMAIL=you@example.com

# Set to 1 while testing to use the Let's Encrypt staging CA.
CERTBOT_STAGING=0

# Where requests are redirected to.
REDIRECT_TARGET=https://standards.buildingsmart.org/IFC/DEV/IFC4_3/HTML

# 1 = keep path + query string when redirecting; 0 = always redirect to REDIRECT_TARGET.
PRESERVE_PATH=1
